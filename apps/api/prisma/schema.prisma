// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// docs/adr/003-prisma-6-pin.md: default output (node_modules/.prisma/client,
// @prisma/client-ээр import) ашиглана — custom "output" зам заавал tsc/nest
// build-ийн outDir руу хуулагддаггүй pre-built .js/native binary агуулдаг
// тул runtime-д MODULE_NOT_FOUND өгдөг байсан.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Phase 1: Branches, Users, Roles, RBAC, Audit log
// docs/plan.md §6.1 (RBAC матриц) ба §6.3 (RLS/transaction загвар)-ийн дагуу
// ─────────────────────────────────────────────────────────

enum RoleName {
  SUPER_ADMIN // Супер админ — бүх салбар
  OWNER // Дэлгүүрийн эзэн — бүх салбар (харах голчлон)
  ALL_BRANCH_MANAGER // Бүх-салбарын менежер — бүх салбарын үйл ажиллагаа
  BRANCH_ADMIN // Салбарын админ — 1 салбар
  BRANCH_MANAGER // Салбарын менежер — 1 салбар
  SALESPERSON // Худалдагч — 1 салбар
  CUSTOMER // Харилцагч
}

enum AuthProvider {
  CUSTOMER_AUTH // утасны дугаар, custom auth модуль (§6.2)
  KEYCLOAK // и-мэйл, ажилтан/эрх бүхий хэрэглэгч (§6.2)
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  district  String?
  latitude  Float?
  longitude Float?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBranchRoles UserBranchRole[]
  inventoryItems  InventoryItem[]
  orders          Order[]

  @@map("branches")
}

model User {
  id           String       @id @default(uuid())
  // Харилцагчид: утасны дугаар (E.164). Ажилтанд: null байж болно.
  phone        String?      @unique
  // Ажилтан/эрх бүхий хэрэглэгчид: и-мэйл. Харилцагчид: null байж болно.
  email        String?      @unique
  passwordHash String? // зөвхөн CUSTOMER_AUTH-д ашиглана (Keycloak өөрөө удирддаг)
  authProvider AuthProvider
  // Keycloak талын хэрэглэгчийн ID (KEYCLOAK үед)
  keycloakSub  String?      @unique
  fullName     String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userBranchRoles        UserBranchRole[]
  auditLogs              AuditLog[]
  orders                 Order[]
  systemSettingUpdates   SystemSetting[]
  returnRequestsMade     ReturnRequest[]    @relation("ReturnRequestedBy")
  returnRequestsReviewed ReturnRequest[]    @relation("ReturnReviewedBy")
  couponsCreated         Coupon[]           @relation("CouponCreatedBy")
  couponRedemptions      CouponRedemption[] @relation("CouponRedeemedBy")

  @@map("users")
}

// Хэрэглэгч + Салбар + Дүр — олон-салбарын RBAC-ийн цөм
// (жиш: нэг худалдагч зөвхөн 1 мөртэй, супер админ мөрөөр нь бүх салбарт биш,
//  харин "хамрах хүрээ" (scope) нь role-оороо тодорхойлогдоно — доорх тайлбар)
model UserBranchRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SUPER_ADMIN, OWNER, ALL_BRANCH_MANAGER мөрүүдэд branchId NULL байж болно
  // (§6.1: "бүх салбар" гэсэн scope-ыг илэрхийлнэ)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role      RoleName
  createdAt DateTime @default(now())

  @@unique([userId, branchId, role])
  @@map("user_branch_roles")
}

// §7 модуль #15 — суурь аудит лог (Phase 1). UI Phase 6-д нэмэгдэнэ.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // жиш: "order.status_changed", "product.updated"
  tableName  String
  recordId   String
  beforeData Json?
  afterData  Json?
  branchId   String? // тухайн үйлдэл ямар салбартай холбоотойг хадгална
  createdAt  DateTime @default(now())

  @@index([tableName, recordId])
  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
// Phase 2, 1-р хэсэг: Каталог ба агуулах (docs/plan.md §7 модуль #3, #4)
// ─────────────────────────────────────────────────────────

// Ангилал — эцэг ангилалтайгаа (parentId) өөртэйгөө self-relation.
// Каталог бүхэлдээ нэвтэрсэн бүх хэрэглэгчид (харилцагч ч) харагдана
// (§6.1 матриц "Бүтээгдэхүүн/каталог" мөр) — RLS: enable_catalog_inventory_rls.
model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  parentId     String?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryParent")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  brand       String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@map("products")
}

// Phase 2, Хэсэг A (§8): MinIO-д хадгалагдсан бүтээгдэхүүний зураг.
// objectKey — MinIO bucket дотрох замын түлхүүр (жиш:
// "products/<productId>/<uuid>.jpg"), бодит файл MinIO-д, ЗӨВХӨН энэ
// түлхүүр PostgreSQL-д. RLS: Category/Product-той адил (SELECT бүх
// нэвтэрсэн хэрэглэгчид, CUD зөвхөн §6.1 матрицын эрхтэй дүрд) —
// enable_product_images_rls migration.
model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey    String
  displayOrder Int      @default(0)
  altText      String?
  createdAt    DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id                      String   @id @default(uuid())
  productId               String
  product                 Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                    String // жиш: хэмжээ/өнгө ("XL, улаан")
  sku                     String   @unique
  unit                    String   @default("ширхэг")
  basePrice               Decimal  @db.Decimal(12, 2)
  costPrice               Decimal? @db.Decimal(12, 2)
  barcode                 String?
  isActive                Boolean  @default(true)
  // Салбарын InventoryItem дээр override-гүй бол ашиглагдах анхны утга
  // (inventory-effective.util.ts-ийн resolveEffectivePreOrder-г үз).
  defaultPreOrderEnabled  Boolean  @default(false)
  defaultPreOrderLeadDays Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// Салбар тус бүрийн нөөц. Харилцагч ХАРАХГҮЙ (§6.1: нөөцийн тоо нууц) —
// RLS: app_can_manage_branch(branchId) эсвэл global scope-той дүрд л
// SELECT/CRUD зөвшөөрнө. Тоо хэмжээ өөрчлөх нь InventoryService-ийн
// adjustQuantity (delta, atomic increment) аргаар л хийгдэнэ.
model InventoryItem {
  id                       String         @id @default(uuid())
  variantId                String
  variant                  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId                 String
  branch                   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity                 Int            @default(0)
  lowStockThreshold        Int            @default(5)
  // ProductVariant-ийн анхны утгыг дарж бичих (override) — NULL бол
  // variant-ийн утгыг ашиглана (inventory-effective.util.ts).
  branchPrice              Decimal?       @db.Decimal(12, 2)
  preOrderEnabledOverride  Boolean?
  preOrderLeadDaysOverride Int?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([variantId, branchId])
  @@index([branchId])
  @@map("inventory_items")
}

// ─────────────────────────────────────────────────────────
// Phase 3a: Сагс ба захиалгын үндсэн урсгал (docs/plan.md §7 модуль #5, #6)
// MVP чиглүүлэлт: харилцагчийн шууд сонгосон branchId = захиалгын салбар
// (geolocation-based auto-routing Phase 3b/backlog). WebSocket/QPay Phase 3b.
// ─────────────────────────────────────────────────────────

enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

// Phase 4 (docs/plan.md §8, Хэсэг A): PICKUP — харилцагч салбар дээр очиж
// авна (delivery талбарууд NULL байх ёстой), DELIVERY — заасан хаяг/
// координат руу хүргэнэ (delivery талбарууд заавал, CheckoutOrderDto-ийн
// @ValidateIf-аар хоёр чиглэлд нь давхар хамгаалагдсан).
enum OrderDeliveryMethod {
  PICKUP
  DELIVERY
}

model Order {
  id                   String              @id @default(uuid())
  customerId           String
  customer             User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId             String
  branch               Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status               OrderStatus         @default(CREATED)
  totalAmount          Decimal             @db.Decimal(12, 2)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  // Phase 4 §8 Хэсэг A: хүргэлтийн арга + (DELIVERY-д л заавал) хаяг/
  // координат. RLS policy өөрчлөлт шаардлагагүй (мөр-түвшний, багана
  // нэмэхэд нөлөөлдөггүй — Phase 2-ийн add_branch_geo_and_catalog_fields-тэй
  // адил урьдал жишээ).
  deliveryMethod       OrderDeliveryMethod @default(PICKUP)
  deliveryAddress      String?
  deliveryLatitude     Float?
  deliveryLongitude    Float?
  // Кэш (§8 Phase 4 засвар): GET /orders/:id/route эхний удаа дуудагдахад
  // RoutingProvider.getRoute()-ийн үр дүнг ЭНД бичиж, дараагийн дуудлагад
  // (ялангуяа OsrmRoutingProvider-ийн public demo server рүү) ДАХИН
  // хандахгүйгээр шууд буцаана — `order.service.ts`-ийн `getRoute()`-ийг
  // үз. deliveryLatitude/Longitude/branchId одоогоор ЗАСВАРЛАГДАХГҮЙ
  // (checkout-ийн дараа Order.branchId/delivery талбар өөрчлөх endpoint
  // байхгүй) тул кэш "хэзээ ч хуучрахгүй" — ирээдүйд ийм endpoint
  // нэмэгдвэл (жиш: staff хаяг засварлах) яг ТЭР update дотор эдгээр 3
  // талбарыг NULL болгож "хүчингүй болгох" (invalidate) ёстой.
  routeDistanceMeters  Float?
  routeDurationSeconds Float?
  // [number, number][] (routing-provider.interface.ts-ийн geometry-тэй
  // адил [lng, lat] дараалалтай) — Prisma-д массив тохирсон scalar төрөл
  // байхгүй тул jsonb-аар хадгална.
  routeGeometry        Json?
  // Phase 3c-ийн 7-хоногийн буцаалтын цонжинд хэрэгтэй тул одоо л оруулав.
  completedAt          DateTime?
  cancelledAt          DateTime?
  // Phase 3b: PaymentProvider.createInvoice()-ийн буцаасан ID (mock эсвэл
  // QPay) — src/payment/payment-provider.interface.ts. Webhook-ийн
  // "verify don't trust" баталгаажуулалтад (app_mark_order_paid SECURITY
  // DEFINER функц, docs/adr/006) ЯГ ЭНЭ утгыг тулгаж шалгадаг тул нэрийг
  // provider-нейтраль болгож сольсон (өмнө нь qpayPaymentId байсан).
  providerInvoiceId    String?             @unique
  // Webhook (POST /payment/webhook/:orderId) идэвхтэй provider-ийн
  // checkPayment()-ээр PAID гэдгийг сервер талд дахин баталгаажуулсны
  // дараа л тавигдана (docs/adr/006) — webhook payload-д ирсэн статусыг
  // шууд итгэж бичихгүй.
  paidAt               DateTime?
  // §7 модуль #10 (Урамшуулал/купон): checkout-ийн үед хэрэглэсэн купоны
  // код + тооцоолсон хямдралын дүнгийн snapshot (ирээдүйд купон устсан/
  // өөрчлөгдсөн ч захиалгын түүхэн дүн хэвээр үлдэх ёстой —
  // ReturnRequest.refundFeePercent/refundAmount-тэй ижил "snapshot"
  // зарчим). totalAmount нь ЭНЭ хямдралыг АЛЬ ХЭДИЙН хассан эцсийн дүн.
  couponCode           String?
  discountAmount       Decimal?            @db.Decimal(12, 2)

  items            OrderItem[]
  couponRedemption CouponRedemption?

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String         @id @default(uuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId         String
  // Захиалагдсан вариант устсан ч түүхэн захиалгын мөр (unitPriceSnapshot
  // хамт) хадгалагдаж үлдэх ёстой тул Cascade биш Restrict.
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity          Int
  // resolveEffectivePrice()-ийн захиалга үүсэх мөчийн утга — түүхэн үнэ,
  // ProductVariant/InventoryItem-ийн дараагийн үнийн өөрчлөлтөөс хамаарахгүй.
  unitPriceSnapshot Decimal        @db.Decimal(12, 2)
  createdAt         DateTime       @default(now())

  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────
// Phase 3c: Буцаалт ба нөхөн төлбөр (docs/plan.md §7 модуль #9)
// ─────────────────────────────────────────────────────────

// Тохиргооны түлхүүр-утга хос (жиш: RETURN_FEE_PERCENT). RLS: SELECT бүх
// нэвтэрсэн хэрэглэгчид, UPDATE зөвхөн app_has_global_scope().
model SystemSetting {
  key             String   @id
  value           String
  updatedByUserId String?
  updatedByUser   User?    @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedAt       DateTime @updatedAt

  @@map("system_settings")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
  REFUND_FAILED
}

// Хүргэгдсэн барааг 7 хоногийн дотор буцаах хүсэлт — staff зөвшөөрсний
// дараа автомат хэсэгчилсэн (шимтгэл хассан) QPay/mock refund
// (ReturnRequestService.approve(), docs/adr/006-ийн PaymentProvider
// абстракцыг дахин ашиглана). 7 хоногийн хугацаа/давхар идэвхтэй хүсэлтийн
// шалгалт DB constraint биш, service давхаргад (цаг хугацаа харьцуулах,
// "идэвхтэй" гэдэг нь REQUESTED/APPROVED status-той гэсэн үг — DB CHECK-ээр
// илэрхийлэхэд төвөгтэй динамик дүрэм тул).
model ReturnRequest {
  id          String    @id @default(uuid())
  orderItemId String
  // Захиалгын мөр (unitPriceSnapshot хэрэгтэй) устсан ч буцаалтын түүх
  // хадгалагдах ёстой тул order_items-тэй адил Restrict (Cascade биш).
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  requestedByUserId String
  requestedByUser   User   @relation("ReturnRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  status ReturnStatus @default(REQUESTED)
  reason String

  rejectedReason String?

  // Зөвшөөрөх мөчийн SystemSetting(RETURN_FEE_PERCENT) утгын snapshot —
  // ирээдүйд тохиргоо өөрчлөгдсөн ч энэ буцаалтын түүхэн тооцоо хэвээр үлдэнэ.
  refundFeePercent Decimal? @db.Decimal(5, 2)
  refundAmount     Decimal? @db.Decimal(12, 2)
  // PaymentProvider.refundPayment()-ийн буцаасан RefundPaymentResult.providerRefundId
  // (docs/adr/006-ийн Order.providerInvoiceId-тэй ижил "provider-неутраль"
  // нэршлийн зарчим — qpayRefundTransactionId БИШ, provider сольж болдог
  // абстракцтай нийцүүлэв).
  providerRefundId String?

  reviewedByUserId String?
  reviewedByUser   User?   @relation("ReturnReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  refundedAt  DateTime?

  @@index([orderItemId])
  @@index([requestedByUserId])
  @@index([status])
  @@map("return_requests")
}

// ─────────────────────────────────────────────────────────
// Урамшуулал/купон (docs/plan.md §7 модуль #10, §6.1 матриц)
// ─────────────────────────────────────────────────────────

enum CouponDiscountType {
  PERCENTAGE // discountValue = 0-100 хооронд, хувиар хямдруулна
  FIXED_AMOUNT // discountValue = тогтмол мөнгөн дүн
}

// §6.1 матриц: SUPER_ADMIN/ALL_BRANCH_MANAGER CRUD, OWNER RU (Create/Delete
// эрхгүй), BRANCH_ADMIN R (бүх), BRANCH_MANAGER/SALESPERSON — (эрхгүй),
// CUSTOMER R (зөвхөн идэвхтэй+хугацаанд байгаа мөр, coupons_select RLS
// policy-оор шүүгдэнэ — enable_coupons_rls migration-ийг үз).
model Coupon {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  discountType      CouponDiscountType
  // PERCENTAGE: 0-100. FIXED_AMOUNT: мөнгөн дүн (₮).
  discountValue     Decimal            @db.Decimal(12, 2)
  // PERCENTAGE-ийн хямдралыг дээд тал нь хязгаарлах (optional) — жиш:
  // "20% хямдрал, гэхдээ 10,000₮-өөс ихгүй".
  maxDiscountAmount Decimal?           @db.Decimal(12, 2)
  minOrderAmount    Decimal?           @db.Decimal(12, 2)

  // null = хязгааргүй нийт ашиглалт.
  usageLimit            Int?
  usageCount            Int  @default(0)
  // ⚠️ MVP-д зөвхөн утга=1-ийг DB unique constraint-аар (@@unique([couponId,
  // customerId]) CouponRedemption дээр) хатуу хамгаалдаг тул >1 утга
  // тохируулбал app_redeem_coupon() SQL функц дотор тоолж шалгах ЗӨВХӨН
  // логик хамгаалалт л ажиллана (DB constraint биш) — хэрэв ирээдүйд
  // "1 хэрэглэгч N удаа" бодит хэрэгцээ гарвал unique constraint-ыг
  // хасаж, зөвхөн функц доторх COUNT() шалгалтад бүрэн шилжих хэрэгтэй.
  usageLimitPerCustomer Int  @default(1)

  validFrom DateTime
  validTo   DateTime
  isActive  Boolean  @default(true)

  createdByUserId String?
  createdByUser   User?    @relation("CouponCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions CouponRedemption[]

  @@map("coupons")
}

// Купон ашигласан түүх — app_redeem_coupon() SECURITY DEFINER функцээр
// л бичигдэнэ (ADR 005 WRITE ангилал, order.service.ts-ийн checkout()-ийн
// доторх нэг atomic алхам). @@unique([couponId, customerId]) нь DB
// түвшинд "1 хэрэглэгч 1 удаа" (usageLimitPerCustomer=1 үеийн) хамгаалалт.
model CouponRedemption {
  id       String @id @default(uuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  // Нэг захиалгад зөвхөн 1 купон (checkout couponCode нэг л талбар).
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  customerId String
  customer   User   @relation("CouponRedeemedBy", fields: [customerId], references: [id], onDelete: Restrict)

  // Redeem хийх мөчийн хямдралын дүнгийн snapshot (Order.discountAmount-тай
  // адилхан утга, хоёр талдаа шалтгаан ялгаатай — энэ бол "яг ямар
  // ашиглалтад ямар дүн ногдсон бэ" гэсэн аудит бичлэг).
  discountAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([couponId, customerId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

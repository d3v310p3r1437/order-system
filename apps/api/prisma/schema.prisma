// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// docs/adr/003-prisma-6-pin.md: default output (node_modules/.prisma/client,
// @prisma/client-ээр import) ашиглана — custom "output" зам заавал tsc/nest
// build-ийн outDir руу хуулагддаггүй pre-built .js/native binary агуулдаг
// тул runtime-д MODULE_NOT_FOUND өгдөг байсан.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Phase 1: Branches, Users, Roles, RBAC, Audit log
// docs/plan.md §6.1 (RBAC матриц) ба §6.3 (RLS/transaction загвар)-ийн дагуу
// ─────────────────────────────────────────────────────────

enum RoleName {
  SUPER_ADMIN       // Супер админ — бүх салбар
  OWNER             // Дэлгүүрийн эзэн — бүх салбар (харах голчлон)
  ALL_BRANCH_MANAGER // Бүх-салбарын менежер — бүх салбарын үйл ажиллагаа
  BRANCH_ADMIN      // Салбарын админ — 1 салбар
  BRANCH_MANAGER    // Салбарын менежер — 1 салбар
  SALESPERSON       // Худалдагч — 1 салбар
  CUSTOMER          // Харилцагч
}

enum AuthProvider {
  CUSTOMER_AUTH // утасны дугаар, custom auth модуль (§6.2)
  KEYCLOAK      // и-мэйл, ажилтан/эрх бүхий хэрэглэгч (§6.2)
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  district  String?
  latitude  Float?
  longitude Float?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBranchRoles UserBranchRole[]
  inventoryItems  InventoryItem[]
  orders          Order[]

  @@map("branches")
}

model User {
  id            String       @id @default(uuid())
  // Харилцагчид: утасны дугаар (E.164). Ажилтанд: null байж болно.
  phone         String?      @unique
  // Ажилтан/эрх бүхий хэрэглэгчид: и-мэйл. Харилцагчид: null байж болно.
  email         String?      @unique
  passwordHash  String?      // зөвхөн CUSTOMER_AUTH-д ашиглана (Keycloak өөрөө удирддаг)
  authProvider  AuthProvider
  // Keycloak талын хэрэглэгчийн ID (KEYCLOAK үед)
  keycloakSub   String?      @unique
  fullName      String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  userBranchRoles UserBranchRole[]
  auditLogs       AuditLog[]
  orders          Order[]

  @@map("users")
}

// Хэрэглэгч + Салбар + Дүр — олон-салбарын RBAC-ийн цөм
// (жиш: нэг худалдагч зөвхөн 1 мөртэй, супер админ мөрөөр нь бүх салбарт биш,
//  харин "хамрах хүрээ" (scope) нь role-оороо тодорхойлогдоно — доорх тайлбар)
model UserBranchRole {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SUPER_ADMIN, OWNER, ALL_BRANCH_MANAGER мөрүүдэд branchId NULL байж болно
  // (§6.1: "бүх салбар" гэсэн scope-ыг илэрхийлнэ)
  branchId String?
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role     RoleName
  createdAt DateTime @default(now())

  @@unique([userId, branchId, role])
  @@map("user_branch_roles")
}

// §7 модуль #15 — суурь аудит лог (Phase 1). UI Phase 6-д нэмэгдэнэ.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // жиш: "order.status_changed", "product.updated"
  tableName  String
  recordId   String
  beforeData Json?
  afterData  Json?
  branchId   String?  // тухайн үйлдэл ямар салбартай холбоотойг хадгална
  createdAt  DateTime @default(now())

  @@index([tableName, recordId])
  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
// Phase 2, 1-р хэсэг: Каталог ба агуулах (docs/plan.md §7 модуль #3, #4)
// ─────────────────────────────────────────────────────────

// Ангилал — эцэг ангилалтайгаа (parentId) өөртэйгөө self-relation.
// Каталог бүхэлдээ нэвтэрсэн бүх хэрэглэгчид (харилцагч ч) харагдана
// (§6.1 матриц "Бүтээгдэхүүн/каталог" мөр) — RLS: enable_catalog_inventory_rls.
model Category {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  parentId     String?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryParent")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  brand       String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id                      String   @id @default(uuid())
  productId               String
  product                 Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                    String // жиш: хэмжээ/өнгө ("XL, улаан")
  sku                     String   @unique
  unit                    String   @default("ширхэг")
  basePrice               Decimal  @db.Decimal(12, 2)
  costPrice               Decimal? @db.Decimal(12, 2)
  barcode                 String?
  isActive                Boolean  @default(true)
  // Салбарын InventoryItem дээр override-гүй бол ашиглагдах анхны утга
  // (inventory-effective.util.ts-ийн resolveEffectivePreOrder-г үз).
  defaultPreOrderEnabled  Boolean  @default(false)
  defaultPreOrderLeadDays Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// Салбар тус бүрийн нөөц. Харилцагч ХАРАХГҮЙ (§6.1: нөөцийн тоо нууц) —
// RLS: app_can_manage_branch(branchId) эсвэл global scope-той дүрд л
// SELECT/CRUD зөвшөөрнө. Тоо хэмжээ өөрчлөх нь InventoryService-ийн
// adjustQuantity (delta, atomic increment) аргаар л хийгдэнэ.
model InventoryItem {
  id                        String         @id @default(uuid())
  variantId                 String
  variant                   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId                  String
  branch                    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity                  Int            @default(0)
  lowStockThreshold         Int            @default(5)
  // ProductVariant-ийн анхны утгыг дарж бичих (override) — NULL бол
  // variant-ийн утгыг ашиглана (inventory-effective.util.ts).
  branchPrice               Decimal?       @db.Decimal(12, 2)
  preOrderEnabledOverride   Boolean?
  preOrderLeadDaysOverride  Int?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@unique([variantId, branchId])
  @@index([branchId])
  @@map("inventory_items")
}

// ─────────────────────────────────────────────────────────
// Phase 3a: Сагс ба захиалгын үндсэн урсгал (docs/plan.md §7 модуль #5, #6)
// MVP чиглүүлэлт: харилцагчийн шууд сонгосон branchId = захиалгын салбар
// (geolocation-based auto-routing Phase 3b/backlog). WebSocket/QPay Phase 3b.
// ─────────────────────────────────────────────────────────

enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model Order {
  id         String      @id @default(uuid())
  customerId String
  customer   User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branchId   String
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status     OrderStatus @default(CREATED)
  totalAmount Decimal    @db.Decimal(12, 2)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  // Phase 3c-ийн 7-хоногийн буцаалтын цонжинд хэрэгтэй тул одоо л оруулав.
  completedAt DateTime?
  cancelledAt DateTime?
  // Phase 3b: PaymentProvider.createInvoice()-ийн буцаасан ID (mock эсвэл
  // QPay) — src/payment/payment-provider.interface.ts. Webhook-ийн
  // "verify don't trust" баталгаажуулалтад (app_mark_order_paid SECURITY
  // DEFINER функц, docs/adr/006) ЯГ ЭНЭ утгыг тулгаж шалгадаг тул нэрийг
  // provider-нейтраль болгож сольсон (өмнө нь qpayPaymentId байсан).
  providerInvoiceId String? @unique
  // Webhook (POST /payment/webhook/:orderId) идэвхтэй provider-ийн
  // checkPayment()-ээр PAID гэдгийг сервер талд дахин баталгаажуулсны
  // дараа л тавигдана (docs/adr/006) — webhook payload-д ирсэн статусыг
  // шууд итгэж бичихгүй.
  paidAt DateTime?

  items OrderItem[]

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  // Захиалагдсан вариант устсан ч түүхэн захиалгын мөр (unitPriceSnapshot
  // хамт) хадгалагдаж үлдэх ёстой тул Cascade биш Restrict.
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  // resolveEffectivePrice()-ийн захиалга үүсэх мөчийн утга — түүхэн үнэ,
  // ProductVariant/InventoryItem-ийн дараагийн үнийн өөрчлөлтөөс хамаарахгүй.
  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  createdAt DateTime       @default(now())

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}


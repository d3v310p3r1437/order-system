<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 9+ (API 28+)-ийн анхдагч cleartext хориглолтыг зөвхөн локал
         dev backend-ийн хаягт (10.0.2.2/localhost) чөлөөлнө — доорх
         res/xml/network_security_config.xml. Зөвхөн debug variant-д
         merge хийгдэнэ, release build-д ОРОХГҮЙ. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
